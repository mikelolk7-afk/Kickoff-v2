generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Auth & User ──────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String?
  credits      Int      @default(0)
  coins        Int      @default(500)
  createdAt    DateTime @default(now())
  role         String   @default("user")
  isBanned     Boolean  @default(false)
  banReason    String?
  bannedUntil  DateTime?
  club         Club?
  transactions      Transaction[]
  managerProfile    ManagerProfile?
  notifications     Notification[]
  notificationPrefs NotificationPrefs?
  messages          Message[]
  loginEvents       LoginEvent[]
  analyticsEvents   AnalyticsEvent[]
  moderationReports ModerationReport[] @relation("ReportedBy")
  moderationTargets ModerationReport[] @relation("ReportedUser")
  adminAuditLogs    AdminAuditLog[]
}

// ─── Club ─────────────────────────────────────────────────

model Club {
  id              String   @id @default(uuid())
  userId          String?  @unique
  name            String
  badgeId         String
  kitHome         String
  kitAway         String
  isAi            Boolean  @default(false)
  aiLevel         Int      @default(1)
  divisionId      String
  reputation      Int      @default(50)
  stadiumCapacity Int      @default(5000)
  trainingLevel   Int      @default(1)
  medicalLevel    Int      @default(1)
  academyLevel    Int      @default(1)
  analyticsLevel  Int      @default(0)
  budget          Int      @default(500000)
  wageBudget      Int      @default(50000)
  weeklyWages     Int      @default(0)
  createdAt       DateTime @default(now())

  user              User?              @relation(fields: [userId], references: [id])
  division          Division           @relation(fields: [divisionId], references: [id])
  players           Player[]
  homeFixtures      Fixture[]          @relation("HomeClub")
  awayFixtures      Fixture[]          @relation("AwayClub")
  tableRows         LeagueTableRow[]
  tactics           Tactic[]
  staff             Staff[]
  sellerListings    TransferListing[]  @relation("SellerListings")
  buyerOffers       TransferOffer[]    @relation("BuyerOffers")
  scoutAssignments  ScoutAssignment[]
  stadiumUpgrades   StadiumUpgrade[]   @relation("StadiumUpgrades")
  facilityUpgrades  FacilityUpgrade[]  @relation("FacilityUpgrades")
  homeCupFixtures   CupFixture[]       @relation("CupHomeClub")
  awayCupFixtures   CupFixture[]       @relation("CupAwayClub")
  wonCupFixtures    CupFixture[]       @relation("CupWinner")
  rivalriesA        Rivalry[]          @relation("RivalryA")
  rivalriesB        Rivalry[]          @relation("RivalryB")

  @@index([divisionId])
}

// ─── Player ───────────────────────────────────────────────

model Player {
  id           String    @id @default(uuid())
  clubId       String
  name         String
  nationality  String
  age          Int
  position     Position
  pace         Int
  shooting     Int
  passing      Int
  dribbling    Int
  defending    Int
  physicality  Int
  composure    Int
  positioning  Int
  overall      Int
  potential    Int
  morale       Int       @default(70)
  form         Int       @default(70)
  injuredUntil DateTime?
  wage         Int
  contractEnd  DateTime
  isYouth      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  club             Club              @relation(fields: [clubId], references: [id])
  matchEvents      MatchEvent[]
  transferListings TransferListing[]

  @@index([clubId])
}

enum Position {
  GK
  DEF
  MID
  FWD
}

// ─── Division & Season ────────────────────────────────────

model Division {
  id      String   @id @default(uuid())
  tier    Int      @unique
  name    String
  clubs   Club[]
  seasons Season[]
}

model Season {
  id         String   @id @default(uuid())
  divisionId String
  number     Int
  startDate  DateTime
  endDate    DateTime?
  isActive   Boolean  @default(true)

  division  Division         @relation(fields: [divisionId], references: [id])
  fixtures  Fixture[]
  tableRows LeagueTableRow[]
}

// ─── Fixtures & Match Events ──────────────────────────────

model Fixture {
  id          String        @id @default(uuid())
  seasonId    String
  homeClubId  String
  awayClubId  String
  matchWeek   Int           @default(1)
  scheduledAt DateTime
  playedAt    DateTime?
  homeScore   Int?
  awayScore   Int?
  status      FixtureStatus @default(SCHEDULED)
  homePoss    Int?
  awayPoss    Int?
  homeShots   Int?
  awayShots   Int?
  homeShotsOnTarget Int?
  awayShotsOnTarget Int?
  homeFouls   Int?
  awayFouls   Int?
  homeCorners Int?
  awayCorners Int?
  homeYellows Int?
  awayYellows Int?
  homeReds    Int?
  awayReds    Int?
  extraTime   Boolean       @default(false)
  penalties   Boolean       @default(false)
  homePenScore Int?
  awayPenScore Int?
  playerRatings Json?
  heatMapData   Json?

  season   Season       @relation(fields: [seasonId], references: [id])
  homeClub Club         @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub Club         @relation("AwayClub", fields: [awayClubId], references: [id])
  events   MatchEvent[]

  @@index([seasonId])
  @@index([homeClubId])
  @@index([awayClubId])
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
}

model MatchEvent {
  id           String    @id @default(uuid())
  fixtureId    String
  minute       Int
  type         EventType
  team         String
  playerId     String?
  assistId     String?
  assistName   String?
  detail       String?
  xPos         Float?
  yPos         Float?

  fixture Fixture @relation(fields: [fixtureId], references: [id])
  player  Player? @relation(fields: [playerId], references: [id])

  @@index([fixtureId])
}

enum EventType {
  GOAL
  SHOT_ON
  SHOT_OFF
  SAVE
  TACKLE
  FOUL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  KICKOFF
  HALFTIME
  FULLTIME
  CORNER
  FREE_KICK
  PENALTY_GOAL
  PENALTY_MISS
  EXTRA_TIME_START
  PENALTY_SHOOTOUT_START
  SECOND_YELLOW
}

// ─── Tactics ──────────────────────────────────────────────

model Tactic {
  id            String   @id @default(uuid())
  clubId        String
  name          String
  formation     String
  mentality     Int
  pressingLevel Int
  positions     Json
  setPieces     Json
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id])

  @@index([clubId])
}

// ─── League Table ─────────────────────────────────────────

model LeagueTableRow {
  id           String @id @default(uuid())
  seasonId     String
  clubId       String
  played       Int    @default(0)
  won          Int    @default(0)
  drawn        Int    @default(0)
  lost         Int    @default(0)
  goalsFor     Int    @default(0)
  goalsAgainst Int    @default(0)
  points       Int    @default(0)

  season Season @relation(fields: [seasonId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])

  @@unique([seasonId, clubId])
  @@index([seasonId])
}

// ─── Staff ────────────────────────────────────────────────

model Staff {
  id     String @id @default(uuid())
  clubId String
  name   String
  role   String
  stars  Int
  wage   Int

  club             Club              @relation(fields: [clubId], references: [id])
  scoutAssignments ScoutAssignment[] @relation("ScoutAssignments")

  @@index([clubId])
}

// ─── Transactions ─────────────────────────────────────────

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  credits     Int      @default(0)
  coins       Int      @default(0)
  description String
  stripeId    String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── Phase 2: Transfer Market ─────────────────────────────

model TransferListing {
  id            String        @id @default(uuid())
  playerId      String
  sellerClubId  String
  askingPrice   Int
  listingType   ListingType   @default(SALE)
  status        ListingStatus @default(ACTIVE)
  expiresAt     DateTime
  loanDuration  Int?
  loanFee       Int?
  wagePct       Int?
  createdAt     DateTime      @default(now())

  player     Player          @relation(fields: [playerId], references: [id])
  sellerClub Club            @relation("SellerListings", fields: [sellerClubId], references: [id])
  offers     TransferOffer[]

  @@index([sellerClubId])
  @@index([status])
  @@index([expiresAt])
}

enum ListingType {
  SALE
  LOAN
  AUCTION
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  WITHDRAWN
}

model TransferOffer {
  id          String      @id @default(uuid())
  listingId   String
  buyerClubId String
  offerFee    Int
  offerWage   Int
  isLoan      Boolean     @default(false)
  status      OfferStatus @default(PENDING)
  counterFee  Int?
  expiresAt   DateTime
  createdAt   DateTime    @default(now())

  listing   TransferListing @relation(fields: [listingId], references: [id])
  buyerClub Club            @relation("BuyerOffers", fields: [buyerClubId], references: [id])

  @@index([listingId])
  @@index([buyerClubId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

// ─── Phase 2: Scouting ────────────────────────────────────

model ScoutAssignment {
  id          String             @id @default(uuid())
  clubId      String
  scoutId     String
  region      String
  duration    Int
  status      ScoutStatus        @default(IN_PROGRESS)
  startedAt   DateTime           @default(now())
  completesAt DateTime
  report      ScoutReport?

  club  Club  @relation(fields: [clubId], references: [id])
  scout Staff @relation("ScoutAssignments", fields: [scoutId], references: [id])

  @@index([clubId])
  @@index([completesAt])
}

enum ScoutStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ScoutReport {
  id           String @id @default(uuid())
  assignmentId String @unique
  players      Json

  assignment ScoutAssignment @relation(fields: [assignmentId], references: [id])
}

// ─── Phase 2: Stadium & Facility Upgrades ─────────────────

model StadiumUpgrade {
  id          String        @id @default(uuid())
  clubId      String
  stand       String
  fromLevel   Int
  toLevel     Int
  status      UpgradeStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completesAt DateTime
  cost        Int

  club Club @relation("StadiumUpgrades", fields: [clubId], references: [id])

  @@index([clubId])
  @@index([completesAt])
}

model FacilityUpgrade {
  id          String        @id @default(uuid())
  clubId      String
  facility    String
  fromLevel   Int
  toLevel     Int
  status      UpgradeStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completesAt DateTime
  cost        Int

  club Club @relation("FacilityUpgrades", fields: [clubId], references: [id])

  @@index([clubId])
  @@index([completesAt])
}

enum UpgradeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Phase 3: Cup Competition ────────────────────────────

model Cup {
  id        String     @id @default(uuid())
  seasonNum Int
  isActive  Boolean    @default(true)
  rounds    CupRound[]
}

model CupRound {
  id       String       @id @default(uuid())
  cupId    String
  roundNum Int
  name     String
  fixtures CupFixture[]

  cup Cup @relation(fields: [cupId], references: [id])

  @@index([cupId])
}

model CupFixture {
  id          String        @id @default(uuid())
  roundId     String
  homeClubId  String
  awayClubId  String
  scheduledAt DateTime
  homeScore   Int?
  awayScore   Int?
  winnerId    String?
  status      FixtureStatus @default(SCHEDULED)

  round    CupRound @relation(fields: [roundId], references: [id])
  homeClub Club     @relation("CupHomeClub", fields: [homeClubId], references: [id])
  awayClub Club     @relation("CupAwayClub", fields: [awayClubId], references: [id])
  winner   Club?    @relation("CupWinner", fields: [winnerId], references: [id])

  @@index([roundId])
  @@index([homeClubId])
  @@index([awayClubId])
}

// ─── Phase 3: Manager Profiles ───────────────────────────

model ManagerProfile {
  id          String @id @default(uuid())
  userId      String @unique
  reputation  Int    @default(50)
  level       Int    @default(1)
  xp          Int    @default(0)
  totalWins   Int    @default(0)
  totalDraws  Int    @default(0)
  totalLosses Int    @default(0)
  trophies    Json   @default("[]")
  history     Json   @default("[]")
  badges      Json   @default("[]")

  user User @relation(fields: [userId], references: [id])
}

// ─── Phase 3: Rivalries ──────────────────────────────────

model Rivalry {
  id        String   @id @default(uuid())
  clubAId   String
  clubBId   String
  intensity Int      @default(1)
  createdAt DateTime @default(now())

  clubA Club @relation("RivalryA", fields: [clubAId], references: [id])
  clubB Club @relation("RivalryB", fields: [clubBId], references: [id])

  @@unique([clubAId, clubBId])
  @@index([clubAId])
  @@index([clubBId])
}

// ─── Phase 3: Notifications ──────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
}

model NotificationPrefs {
  userId       String  @id
  matchResults Boolean @default(true)
  transfers    Boolean @default(true)
  scouting     Boolean @default(true)
  upgrades     Boolean @default(false)
  cup          Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

// ─── Phase 3: Chat ───────────────────────────────────────

model ChatRoom {
  id       String    @id @default(uuid())
  type     RoomType
  refId    String?
  messages Message[]

  @@index([type, refId])
}

enum RoomType {
  DIVISION
  GLOBAL
  DIRECT
  MATCH
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([roomId, createdAt])
}

// ─── Phase 5: Analytics ─────────────────────────────────

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  data      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([event])
  @@index([createdAt])
  @@index([userId])
}

// ─── Phase 5: Moderation ────────────────────────────────

model ModerationReport {
  id           String           @id @default(uuid())
  reportedById String
  targetUserId String
  reason       String
  messageId    String?
  status       ModerationStatus @default(PENDING)
  resolution   String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?

  reportedBy  User @relation("ReportedBy", fields: [reportedById], references: [id])
  targetUser  User @relation("ReportedUser", fields: [targetUserId], references: [id])

  @@index([status])
  @@index([targetUserId])
  @@index([createdAt])
}

enum ModerationStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

// ─── Phase 5: Admin Audit Log ───────────────────────────

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String
  detail    Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}
